{
  "name": "weather",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint --quiet",
    "deploy-staging": "ts-node --project scripts/tsconfig.json scripts/deploy staging",
    "deploy": "ts-node --project scripts/tsconfig.json scripts/deploy production",
    "prepwa-dev-server": "ng build",
    "pwa-dev-server": "http-server -p 8080 -c-1 dist/weather",
    "prettier-all": "prettier --write \"**/*.{css,html,js,json,md,scss,ts,yml}\"",
    "presource-map-explorer": "ng build --source-map",
    "source-map-explorer": "source-map-explorer 'dist/weather/browser/*.js'"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.2",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.0",
    "@bugsnag/js": "^7.21.0",
    "@s-libs/js-core": "^18.0.0",
    "@s-libs/micro-dash": "^18.0.0",
    "@s-libs/ng-core": "^18.0.0",
    "@s-libs/ng-mat-core": "^18.0.0",
    "@s-libs/rxjs-core": "^18.0.0",
    "@s-libs/signal-store": "^18.0.0",
    "chart.js": "^4.4.0",
    "chartjs-adapter-luxon": "^1.1.0",
    "chartjs-plugin-annotation": "^3.0.1",
    "chartjs-plugin-zoom": "^2.0.1",
    "luxon": "^3.4.4",
    "mixpanel-browser": "^2.54.0",
    "rxjs": "~7.8.0",
    "suncalc": "^1.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.0",
    "@bugsnag/source-maps": "^2.3.0",
    "@eslint/js": "^10.0.1",
    "@s-libs/eslint-config-ng": "^18.0.0",
    "@s-libs/ng-dev": "^18.0.0",
    "@types/jasmine": "~6.0.0",
    "@types/luxon": "^3.3.4",
    "@types/mixpanel-browser": "^2.49.1",
    "@types/node": "^26.0.1",
    "@types/suncalc": "^1.9.2",
    "angular-eslint": "22.0.0",
    "eslint": "^10.3.0",
    "commander": "^12.1.0",
    "eslint-config-prettier": "^9.1.0",
    "expect-type": "^0.19.0",
    "http-server": "^14.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "prettier": "^3.8.1",
    "source-map-explorer": "^2.4.2",
    "ts-node": "^10.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.60.1",
    "utility-types": "^3.10.0"
  }
