{
  "name": "weather",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint --quiet",
    "backend": "firebase emulators:start --only functions,hosting",
    "deploy-staging": "ts-node --project scripts/tsconfig.json scripts/deploy staging",
    "deploy": "ts-node --project scripts/tsconfig.json scripts/deploy production",
    "prettier-all": "prettier --write \"**/*.{css,html,js,json,md,scss,ts,yml}\"",
    "presource-map-explorer": "ng build --source-map",
    "source-map-explorer": "source-map-explorer 'dist/weather/browser/*.js' --no-border-checks"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.2",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.0",
    "@bugsnag/js": "^8.9.0",
    "@s-libs/js-core": "^22.0.0-next.2",
    "@s-libs/micro-dash": "^22.0.0-next.2",
    "@s-libs/ng-core": "^22.0.0-next.2",
    "@s-libs/ng-mat-core": "^22.0.0-next.2",
    "@s-libs/rxjs-core": "^22.0.0-next.2",
    "@s-libs/signal-store": "^22.0.0-next.2",
    "chart.js": "^4.5.1",
    "chartjs-adapter-luxon": "^1.1.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "luxon": "^3.7.2",
    "mixpanel-browser": "^2.73.0",
    "rxjs": "~7.8.0",
    "suncalc": "^2.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.0",
    "@bugsnag/source-maps": "^2.3.0",
    "@eslint/js": "^10.0.1",
    "@s-libs/eslint-config-ng": "^22.0.0-next.2",
    "@s-libs/ng-dev": "^22.0.0-next.2",
    "@s-libs/ng-vitest": "^22.0.0-next.2",
    "@types/luxon": "^3.7.2",
    "@types/mixpanel-browser": "^2.60.0",
    "@types/node": "^26.0.1",
    "@vitest/browser-playwright": "^4.1.9",
    "angular-eslint": "22.0.0",
    "commander": "^15.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "expect-type": "^0.19.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "source-map-explorer": "^2.4.2",
    "ts-node": "^10.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.60.1",
    "utility-types": "^3.10.0",
    "vitest": "^4.0.8"
  }
}
