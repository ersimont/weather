{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "build:watch",
      "path": "functions/",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "emulate",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dev: All",
      "dependsOn": ["Watch Functions", "Watch App", "Emulate"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Test: Current File",
      "type": "npm",
      "script": "test -- --include ${relativeFile}",
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "deploy-staging",
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "deploy",
      "problemMatcher": []
    }
  ]
}
